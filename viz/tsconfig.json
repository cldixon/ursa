{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    // The site consumes this package as TypeScript source through the bundler,
    // so resolution matches how it is actually read rather than how a published
    // package would be. `noEmit` for the same reason: there is no build step —
    // the consumer's bundler compiles it.
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}
