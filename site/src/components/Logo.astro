---
// The Big Dipper: Ursa Major's seven bright stars, sized by magnitude. The
// same drawing as the web shell's (web/public/index.html), in currentColor so
// it follows the theme.
interface Props {
	class?: string;
}
const { class: className } = Astro.props;
---

<svg class:list={["ursa-logo", className]} viewBox="1 2.2 20.4 8.6" aria-hidden="true">
	<path
		d="M19.4 4.2 19.2 8.4 15.1 9.1 15.3 5.2 Z M15.3 5.2 11.2 6.0 7.6 4.9 3.2 6.7"
		fill="none"
		stroke="currentColor"
		stroke-width="0.6"
		stroke-linejoin="round"
		opacity="0.45"></path>
	<g fill="currentColor">
		<circle cx="19.4" cy="4.2" r="1.5"></circle><circle cx="15.3" cy="5.2" r="1.0"></circle>
		<circle cx="15.1" cy="9.1" r="1.15"></circle><circle cx="19.2" cy="8.4" r="1.2"></circle>
		<circle cx="11.2" cy="6.0" r="1.85"></circle><circle cx="7.6" cy="4.9" r="1.3"></circle>
		<circle cx="3.2" cy="6.7" r="1.7"></circle>
	</g>
</svg>
