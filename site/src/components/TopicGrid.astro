---
// A grid of TopicCards: three wide on a wide screen, as on duckdb.org/docs.
---

<div class="topic-grid not-content"><slot /></div>

<style>
	.topic-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem;
		margin-top: 1rem;
	}
	@media (min-width: 40rem) {
		.topic-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (min-width: 72rem) {
		.topic-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}
</style>
