---
import { DOCS_NAV } from '../lib/site';
import { url } from '../lib/url';

const path = Astro.url.pathname.replace(/\/+$/, '');
---

<div class="index">
  {
    DOCS_NAV.map((section) => (
      <section>
        <p class="label">{section.title}</p>
        <ul>
          {section.items
            .filter((item) => url(item.href).replace(/\/+$/, '') !== path)
            .map((item) => (
              <li>
                <a href={url(item.href)}>{item.title}</a>
                {item.blurb && <span class="cap blurb">{item.blurb}</span>}
              </li>
            ))}
        </ul>
      </section>
    ))
  }
</div>

<style>
  .index {
    border-top: 1px solid var(--rule);
    margin-top: 26px;
  }
  section {
    display: grid;
    gap: 6px 26px;
    padding: 18px 0;
    border-bottom: 1px solid var(--rule);
  }
  @media (min-width: 640px) {
    section {
      grid-template-columns: 8rem 1fr;
      align-items: baseline;
    }
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  li {
    display: grid;
    gap: 2px 14px;
  }
  @media (min-width: 760px) {
    li {
      grid-template-columns: 14rem 1fr;
      align-items: baseline;
    }
  }
  li + li {
    margin-top: 9px;
  }
  li a {
    font-size: 16.5px;
  }
  .blurb {
    display: block;
  }
</style>
