---
// On a narrow screen the header has no room for the Ursa Shell link, so the
// menu carries it, above Starlight's theme and social links.
import Default from "@astrojs/starlight/components/MobileMenuFooter.astro";
import { SHELL_URL } from "../consts";
---

<a class="try" href={SHELL_URL}>Try Ursa in your browser: Ursa Shell</a>
<Default />

<style>
	.try {
		display: block;
		margin-bottom: 1rem;
		padding: 0.6rem 0.9rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		color: var(--sl-color-white);
		font-weight: 500;
		text-decoration: none;
	}
</style>
