---
import { SITE } from '../lib/site';
import { url } from '../lib/url';

interface Props {
  bare?: boolean;
}
const { bare = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/+$/, '');
const inDocs = path.includes('/docs');
---

<header class:list={['hdr', { bare }]}>
  <div class="w row">
    <a class="wordmark" href={url('/')} aria-label="Ursa — home">
      <svg viewBox="0 0 22 22" width="15" height="15" aria-hidden="true" class="mark">
        <!-- The mark is the plate at its smallest: the asterism, one mapping. -->
        <g stroke="currentColor" stroke-width="0.7" opacity="0.45" fill="none">
          <path d="M19.4 4.2 19.2 8.4 15.1 9.1 15.3 5.2 Z" />
          <path d="M15.3 5.2 11.2 6.0 7.6 4.9 3.2 6.7" />
        </g>
        <g fill="currentColor">
          <circle cx="19.4" cy="4.2" r="1.5"></circle>
          <circle cx="15.3" cy="5.2" r="1.0"></circle>
          <circle cx="15.1" cy="9.1" r="1.15"></circle>
          <circle cx="19.2" cy="8.4" r="1.2"></circle>
          <circle cx="11.2" cy="6.0" r="1.85"></circle>
          <circle cx="7.6" cy="4.9" r="1.3"></circle>
          <circle cx="3.2" cy="6.7" r="1.7"></circle>
        </g>
      </svg>
      <span>Ursa</span>
    </a>

    <nav aria-label="Primary">
      <a href={url('/docs')} aria-current={inDocs ? 'page' : undefined}>Documentation</a>
      <a href={url('/docs/reference')}>Catalog</a>
      <a href={SITE.repo} rel="noopener">GitHub</a>
    </nav>
  </div>
</header>

<style>
  .hdr {
    border-bottom: 1px solid var(--rule);
  }
  .hdr.bare {
    border-bottom: 0;
  }
  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding-block: 14px;
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    border-bottom: 0;
    font-size: 19px;
    letter-spacing: 0.005em;
  }
  .mark {
    display: block;
    flex: none;
  }
  nav {
    display: flex;
    gap: clamp(14px, 2.4vw, 28px);
    font-family: var(--mono);
    font-size: 12px;
  }
  nav a {
    border-bottom: 0;
    color: var(--ink-2);
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--ink);
  }
</style>
