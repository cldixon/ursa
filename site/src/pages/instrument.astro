---
/**
 * The instrument, live.
 *
 * A working surface for the renderer rather than a documentation page: it exists
 * so the thing can be looked at and argued with — palettes, stretches, sizes, both
 * grounds — while the design is still being settled. The controls are the knobs
 * that decision needs, not a product feature.
 *
 * Linked from the roadmap, not the header navigation: it is a working surface,
 * not documentation.
 *
 * **Every number here is Ursa's.** Degree, PageRank and the communities are
 * computed by the engine in `site/fixtures/generate.py` and committed as a
 * fixture; CI regenerates and fails if the committed file drifts. The one
 * exception is the layout — Ursa has no layout kernel yet (`layout_fa2`, blocked
 * on the multi-output half of #115) — and the generator marks the single call
 * that will change when it lands.
 */
import Base from '../layouts/Base.astro';
import lesmis from '../fixtures/lesmis.json';

const nodeCount = lesmis.ids.length;
const edgeCount = lesmis.edges.length / 2;
const communityCount = new Set(lesmis.community).size;
---

<Base
  title="Instrument"
  description="The Ursa renderer, live: pan, zoom and hover a graph on either ground."
>
  <section class="wrap">
    <header class="head">
      <h1>Instrument</h1>
      <p class="sub">
        {`${lesmis.title} · ${nodeCount} characters · ${edgeCount} co-occurrences · ${communityCount} communities · every value computed by Ursa, layout included`}
      </p>
    </header>

    <div class="controls">
      <label>
        Ground
        <select id="ground">
          <option value="plate">plate</option>
          <option value="sky" selected>sky</option>
        </select>
      </label>
      <label>
        Colour by
        <select id="colour">
          <option value="pagerank">pagerank (continuous)</option>
          <option value="degree">degree (continuous)</option>
          <option value="community">louvain community (categorical)</option>
        </select>
      </label>
      <label>
        Stretch
        <select id="stretch">
          <option value="asinh">asinh</option>
          <option value="log">log</option>
          <option value="linear">linear</option>
        </select>
      </label>
      <button id="fit" type="button">Fit</button>
      <span class="hint">drag to pan · scroll to zoom · hover a node</span>
      <span class="note" id="note"></span>
    </div>

    <div class="stage" id="stage" data-ground="sky">
      <div class="mount" id="mount"></div>
      <div class="readout" id="readout" hidden></div>
    </div>
  </section>

  <script>
    import { createInstrument, type Channel, type StretchName } from '@ursa/viz';
    // The fixture Ursa produced. Imported, not fetched: Astro inlines it into the
    // page bundle, so the figure needs no request of its own.
    import data from '../fixtures/lesmis.json';

    const ids: string[] = data.ids;
    const x = Float32Array.from(data.x);
    const y = Float32Array.from(data.y);
    const degree = Float32Array.from(data.degree);
    const pagerank = Float32Array.from(data.pagerank);
    const edges = Uint32Array.from(data.edges);
    // Real communities, from Ursa's weighted Louvain over the co-occurrence
    // weights — which is why the palette limit below is a genuine finding about
    // this graph rather than an artefact of a synthetic partition.
    const community = Uint32Array.from(data.community);

    const stage = document.getElementById('stage') as HTMLElement;
    const mount = document.getElementById('mount') as HTMLElement;
    const readout = document.getElementById('readout') as HTMLElement;
    const note = document.getElementById('note') as HTMLElement;

    const instrument = createInstrument(mount, {
      onHover: ({ node, screenX, screenY }) => {
        if (node < 0) {
          readout.hidden = true;
          return;
        }
        readout.hidden = false;
        readout.style.transform = `translate(${screenX}px, ${screenY}px)`;
        readout.textContent = `${ids[node]} · deg ${degree[node]} · pr ${pagerank[node]!.toFixed(4)}`;
      },
    });

    function currentColour(): Channel {
      const kind = (document.getElementById('colour') as HTMLSelectElement).value;
      const stretch = (document.getElementById('stretch') as HTMLSelectElement)
        .value as StretchName;
      if (kind === 'community') return { kind: 'categorical', codes: community };
      return { kind: 'continuous', values: kind === 'degree' ? degree : pagerank, stretch };
    }

    function apply(): void {
      instrument.setGraph({
        x,
        y,
        edges,
        // Degree drives size throughout, so switching the colour channel changes
        // one variable at a time — which is the point of a page for comparing them.
        size: { kind: 'continuous', values: degree, stretch: 'log' },
        color: currentColour(),
      });
      // Surface the palette limit rather than letting repeated greys read as a
      // coincidence. This is the open design question in the handoff.
      const n = instrument.categoryCount;
      note.textContent =
        n > 4 ? `${n} communities, 4 flat greys — colours repeat past the fourth` : '';
    }

    for (const id of ['colour', 'stretch']) {
      document.getElementById(id)?.addEventListener('change', apply);
    }
    document.getElementById('ground')?.addEventListener('change', (e) => {
      stage.dataset.ground = (e.target as HTMLSelectElement).value;
      // Colours are baked into the vertex buffers, so a ground change has to
      // rebuild them rather than just repaint.
      instrument.refreshTheme();
    });
    document.getElementById('fit')?.addEventListener('click', () => instrument.fit());

    apply();
  </script>
</Base>

<style>
  .wrap {
    max-width: var(--w-page);
    margin: 0 auto;
    padding: 32px var(--pad-x) 64px;
  }
  .head h1 {
    font-family: var(--serif);
    font-size: 2rem;
    margin: 0;
  }
  .sub {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--ink-2);
    margin: 6px 0 0;
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    align-items: center;
    margin: 24px 0 12px;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--ink-2);
  }
  .controls label {
    display: flex;
    gap: 6px;
    align-items: center;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .controls select,
  .controls button {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--rule);
    padding: 4px 8px;
  }
  .controls button {
    cursor: pointer;
  }
  .note {
    color: var(--paper-ramp-0);
  }
  .hint {
    opacity: 0.65;
  }
  .stage {
    position: relative;
    height: min(72vh, 720px);
    border: 1px solid var(--rule);
    background: var(--paper);
  }
  .mount {
    position: absolute;
    inset: 0;
  }
  /* The label rides above the canvas and must never eat a pointer event, or
     hovering a node would immediately un-hover it as the label slid under the
     cursor. */
  .readout {
    position: absolute;
    top: 0;
    left: 0;
    pointer-events: none;
    font-family: var(--mono);
    font-size: 0.7rem;
    white-space: nowrap;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--rule);
    padding: 3px 6px;
    margin: 10px 0 0 12px;
  }
</style>
