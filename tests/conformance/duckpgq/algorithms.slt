# DuckPGQ's graph algorithm calls (#298): its positional (graph, vertex
# table, edge table) form, its function names and its output columns, on its
# canonical graph. Written from DuckPGQ's documented behaviour, not copied
# from its tests. Expected results are DuckPGQ's; where Ursa's values differ
# on purpose (they are NetworkX's), the case is on ../known_differences.toml.

statement ok
CREATE TABLE Student AS SELECT * FROM (VALUES (0,'Daniel'),(1,'Tavneet'),(2,'Gabor'),(3,'Peter'),(4,'David')) t(id, name);

statement ok
CREATE TABLE know AS SELECT * FROM (VALUES (0,1,10),(0,2,11),(0,3,12),(3,0,13),(1,2,14),(1,3,15),(2,3,16),(4,3,17)) t(src, dst, createDate);

statement ok
CREATE TABLE School AS SELECT * FROM (VALUES ('VU',0,0),('UVA',1,0)) t(school_name, school_id, school_kind);

statement ok
CREATE TABLE StudyAt AS SELECT * FROM (VALUES (0,0),(1,0),(2,1),(3,1),(4,1)) t(personId, schoolId);

statement ok
CREATE PROPERTY GRAPH pg
VERTEX TABLES (Student PROPERTIES (id, name) LABEL Person, School LABEL School)
EDGE TABLES (
  know    SOURCE KEY (src) REFERENCES Student (id) DESTINATION KEY (dst) REFERENCES Student (id)
          PROPERTIES (createDate) LABEL Knows,
  studyAt SOURCE KEY (personId) REFERENCES Student (id) DESTINATION KEY (schoolId) REFERENCES School (school_id));

# id: duckpgq/pagerank/1  DuckPGQ's values, which sum to 0.94 (Ursa's are NetworkX's and sum to 1)
query IR
SELECT id, round(pagerank, 3) FROM pagerank(pg, Student, know) ORDER BY id;
----
0 0.307
1 0.115
2 0.164
3 0.328
4 0.028

# id: duckpgq/pagerank/2  the same order of nodes
query I
SELECT id FROM pagerank(pg, Student, know) ORDER BY pagerank DESC;
----
3
0
2
1
4

# id: duckpgq/pagerank/3  the pair by label is the pair by table
query I
SELECT count(*) FROM pagerank(pg, Person, Knows) p JOIN pagerank(pg, student, know) q ON p.id = q.id AND p.pagerank = q.pagerank;
----
5

# id: duckpgq/pagerank/4  an edge table between two vertex tables
statement error goes from vertex table 'student' to 'school'
SELECT * FROM pagerank(pg, Student, studyAt);

# id: duckpgq/wcc/1  weakly_connected_component, with DuckPGQ's column componentId
query I
SELECT count(DISTINCT componentId) FROM weakly_connected_component(pg, Student, know);
----
1

# id: duckpgq/wcc/2
query I
SELECT count(*) FROM weakly_connected_component(pg, Student, know) WHERE componentId IS NOT NULL;
----
5

# id: duckpgq/lcc/1  local_clustering_coefficient, reading edges as undirected
query IR
SELECT id, round(local_clustering_coefficient, 3) FROM local_clustering_coefficient(pg, Student, know) ORDER BY id;
----
0 1.0
1 1.0
2 1.0
3 0.5
4 0.0

# id: duckpgq/lcc/2  a vertex table the edge table does not connect
statement error connects vertex table 'student', not 'school'
SELECT * FROM local_clustering_coefficient(pg, School, know);

# id: duckpgq/paths/1  DuckPGQ's scalar path functions are the plumbing of its MATCH
statement error ANY SHORTEST
SELECT iterativelength(0, 5, 0, 3);

# id: duckpgq/paths/2
statement error ANY SHORTEST
SELECT shortestpath(0, 5, 0, 3);

# id: duckpgq/summarize/1  SUMMARIZE PROPERTY GRAPH on a graph of two edge tables names the pair to describe
statement error name the pair to describe
SUMMARIZE PROPERTY GRAPH pg;
