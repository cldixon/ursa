# The starter cases of the conformance suite (#299), from the SQL surface
# review (#408): GRAPH_TABLE and CREATE PROPERTY GRAPH on DuckPGQ's canonical
# graph. Expected results are the reference's (the standard's, or DuckPGQ's
# where the standard leaves it open); where Ursa differs, the case is on
# ../known_differences.toml.

statement ok
CREATE TABLE Student AS SELECT * FROM (VALUES (0,'Daniel'),(1,'Tavneet'),(2,'Gabor'),(3,'Peter'),(4,'David')) t(id, name);

statement ok
CREATE TABLE know AS SELECT * FROM (VALUES (0,1,10),(0,2,11),(0,3,12),(3,0,13),(1,2,14),(1,3,15),(2,3,16),(4,3,17)) t(src, dst, createDate);

statement ok
CREATE TABLE School AS SELECT * FROM (VALUES ('VU',0,0),('UVA',1,0)) t(school_name, school_id, school_kind);

statement ok
CREATE TABLE StudyAt AS SELECT * FROM (VALUES (0,0),(1,0),(2,1),(3,1),(4,1)) t(personId, schoolId);

# id: ddl/1  DuckPGQ's definition, unchanged
statement ok
CREATE PROPERTY GRAPH pg
VERTEX TABLES (Student PROPERTIES (id, name) LABEL Person, School LABEL School)
EDGE TABLES (
  know    SOURCE KEY (src) REFERENCES Student (id) DESTINATION KEY (dst) REFERENCES Student (id)
          PROPERTIES (createDate) LABEL Knows,
  studyAt SOURCE KEY (personId) REFERENCES Student (id) DESTINATION KEY (schoolId) REFERENCES School (school_id));

# id: ddl/2
statement error graph 'pg' already exists
CREATE PROPERTY GRAPH pg EDGE TABLES (know SOURCE KEY (src) DESTINATION KEY (dst));

# id: ddl/3  composite keys
statement ok
CREATE PROPERTY GRAPH g2 VERTEX TABLES (Student KEY (id)) EDGE TABLES (know KEY (src, dst) SOURCE KEY (src) REFERENCES Student (id) DESTINATION KEY (dst) REFERENCES Student (id));

# id: ddl/4  REFERENCES without a column list: the vertex table's key (#413)
statement ok
CREATE PROPERTY GRAPH g3 VERTEX TABLES (Student KEY (id)) EDGE TABLES (know SOURCE KEY (src) REFERENCES Student DESTINATION KEY (dst) REFERENCES Student);

# id: ddl/5
query I
SELECT count(*) FROM GRAPH_TABLE (g3 MATCH (a)-[k]->(b) COLUMNS (a.id));
----
8

# id: match/1  one edge
query II rowsort
SELECT * FROM GRAPH_TABLE (pg MATCH (a:Person)-[k:knows]->(b:Person) WHERE a.name = 'Daniel' COLUMNS (a.id AS a, b.id AS b));
----
0 1
0 2
0 3

# id: match/2  IS label, property projection
query IT
SELECT * FROM GRAPH_TABLE (pg MATCH (a IS Person) COLUMNS (a.id AS a, a.name)) ORDER BY a LIMIT 2;
----
0 Daniel
1 Tavneet

# id: match/3  an edge condition, an edge property
query III rowsort
SELECT * FROM GRAPH_TABLE (pg MATCH (a:Person)-[k:knows WHERE k.createDate > 15]->(b:Person) COLUMNS (a.id, b.id, k.createDate));
----
2 3 16
4 3 17

# id: match/4  either direction: each edge twice
query I
SELECT count(*) FROM GRAPH_TABLE (pg MATCH (a:Person)-[k:knows]-(b:Person) COLUMNS (a.id));
----
16

# id: match/5  two-edge chains
query I
SELECT count(*) FROM GRAPH_TABLE (pg MATCH (a:Person)-[:knows]->(b:Person)-[:knows]->(c:Person) COLUMNS (a.id));
----
11

# id: match/5b  a fork
query I
SELECT count(*) FROM GRAPH_TABLE (pg MATCH (a:Person)-[:knows]->(b:Person)<-[:knows]-(c:Person) COLUMNS (a.id));
----
22

# id: match/6  two path patterns with no shared variable: a cross product
query I
SELECT count(*) FROM GRAPH_TABLE (pg MATCH (a:Person), (b:Person) COLUMNS (a.id));
----
25

# id: match/7  across two vertex tables
query T rowsort
SELECT * FROM GRAPH_TABLE (pg MATCH (a:Person)-[s:studyAt]->(b:School) WHERE b.school_name = 'VU' COLUMNS (a.name));
----
Daniel
Tavneet

# id: match/8  a node label that contradicts the edge's REFERENCES (#410): no rows in the standard
query IT rowsort
SELECT * FROM GRAPH_TABLE (pg MATCH (a:Person)-[k:knows]->(b:School) COLUMNS (a.id, b.school_name));
----

# id: match/9  text left over after a condition is a syntax error (#409)
statement error
SELECT * FROM GRAPH_TABLE (pg MATCH (a:Person)-[k:knows]->(b:Person) WHERE a.id = 0 b.id = 3 COLUMNS (a.id AS a, b.id AS b));

# id: match/11  an unlabelled variable over several tables (#412)
query I
SELECT count(*) FROM GRAPH_TABLE (pg MATCH (a) COLUMNS (a.id));
----
7

# id: match/11b  a label expression (#412)
statement ok
SELECT * FROM GRAPH_TABLE (pg MATCH (a:Person|School) COLUMNS (a.id));

# id: columns/1  COLUMNS left out: every property of every named variable (DuckPGQ)
query IT rowsort
SELECT * FROM GRAPH_TABLE (pg MATCH (a:Person WHERE a.id < 2));
----
0 Daniel
1 Tavneet

# id: columns/2  COLUMNS (*)
query IT rowsort
SELECT * FROM GRAPH_TABLE (pg MATCH (a:Person WHERE a.id > 2) COLUMNS (*));
----
3 Peter
4 David

# id: columns/3
query I
SELECT count(*) FROM GRAPH_TABLE (pg MATCH (a:Person)-[k:knows]->(b:Person) COLUMNS (*));
----
8

# id: edges/1  <-[e]-> is left or right
query I
SELECT count(*) FROM GRAPH_TABLE (pg MATCH (a:Person)<-[k:knows]->(b:Person) COLUMNS (a.id));
----
16

# id: edges/2  <-> is left or right
query I
SELECT count(*) FROM GRAPH_TABLE (pg MATCH (a:Person)<->(b:Person) COLUMNS (a.id));
----
16

# id: edges/3  ~[e]~ follows undirected edges; pg has none
query I
SELECT count(*) FROM GRAPH_TABLE (pg MATCH (a:Person)~[k:knows]~(b:Person) COLUMNS (a.id));
----
0

# id: element_id/1  element_id of a node
query II
SELECT * FROM GRAPH_TABLE (pg MATCH (a:Person WHERE a.id = 3)-[s:studyAt]->(b:School) COLUMNS (element_id(a) AS ea, element_id(b) AS eb));
----
3 1

# id: element_id/2  element_id of an edge: its row, as edges(p) lists it
query II rowsort
SELECT * FROM GRAPH_TABLE (pg MATCH p = (a:Person WHERE a.id = 1)-[k:knows]->(b:Person) COLUMNS (b.id, element_id(k)));
----
2 4
3 5

# id: element_id/3  element_id of an edge read by a join
query II rowsort
SELECT * FROM GRAPH_TABLE (pg MATCH (a:Person WHERE a.id = 1)-[k:knows]->(b:Person) COLUMNS (b.id, element_id(k)));
----
2 4
3 5

# id: predicates/1  ALL_DIFFERENT
query I
SELECT count(*) FROM GRAPH_TABLE (pg MATCH (a:Person)-[:knows]->(b:Person)-[:knows]->(c:Person) WHERE all_different(a, b, c) COLUMNS (a.id));
----
9

# id: predicates/2  SAME
query I
SELECT count(*) FROM GRAPH_TABLE (pg MATCH (a:Person)-[:knows]->(b:Person)-[:knows]->(c:Person) WHERE NOT same(a, c) COLUMNS (a.id));
----
9

# id: predicates/3  IS LABELED
query II
SELECT * FROM GRAPH_TABLE (pg MATCH (a:Person)-[k:knows]->(b:Person) WHERE k IS LABELED Knows AND a IS NOT LABELED School AND a.id = 4 COLUMNS (a.id, b.id));
----
4 3

# id: predicates/4  IS SOURCE OF, on an edge matched either way
query I rowsort
SELECT * FROM GRAPH_TABLE (pg MATCH (a:Person WHERE a.id = 0)-[k:knows]-(b:Person) WHERE a IS SOURCE OF k COLUMNS (b.id));
----
1
2
3

# id: predicates/5  IS DESTINATION OF
query I
SELECT * FROM GRAPH_TABLE (pg MATCH (a:Person WHERE a.id = 0)-[k:knows]-(b:Person) WHERE a IS DESTINATION OF k COLUMNS (b.id));
----
3

# id: path/1  bounded quantifier: a walk per path
query II rowsort
SELECT * FROM GRAPH_TABLE (pg MATCH (a:Person WHERE a.id = 0)-[k:knows]->{1,2}(b:Person) COLUMNS (a.id AS a, b.id AS b));
----
0 0
0 1
0 2
0 2
0 3
0 3
0 3

# id: path/2  ANY SHORTEST with *, from one node. DuckPGQ's element_id lists vertex, edge, vertex.
query IIT rowsort
SELECT b, len, array_to_string(ids, ',') FROM GRAPH_TABLE (pg MATCH p = ANY SHORTEST (a:Person WHERE a.id = 0)-[k:knows]->*(b:Person) COLUMNS (b.id AS b, path_length(p) AS len, element_id(p) AS ids));
----
0 0 0
1 1 0,0,1
2 1 0,1,2
3 1 0,2,3

# id: path/3  + from a node back to itself is a cycle (the standard; DuckPGQ leaves it out)
query II rowsort
SELECT * FROM GRAPH_TABLE (pg MATCH p = ANY SHORTEST (a:Person)-[k:knows]->+(b:Person) WHERE a.name = 'Daniel' COLUMNS (b.id AS b, path_length(p) AS len));
----
0 2
1 1
2 1
3 1

# id: path/4  all pairs: 21 rows; node 4 is reached by nobody
query I
SELECT count(*) FROM GRAPH_TABLE (pg MATCH p = ANY SHORTEST (a:Person)-[k:knows]->*(b:Person) COLUMNS (a.id, b.id));
----
21

# id: path/5  SHORTEST k
query T
SELECT array_to_string(v, ',') FROM GRAPH_TABLE (pg MATCH p = SHORTEST 2 (a:Person WHERE a.id = 0)-[k:knows]->+(b:Person WHERE b.id = 3) COLUMNS (vertices(p) AS v));
----
0,3
0,1,3

# id: path/5b  ALL SHORTEST
query T
SELECT array_to_string(v, ',') FROM GRAPH_TABLE (pg MATCH p = ALL SHORTEST (a:Person WHERE a.id = 0)-[k:knows]->+(b:Person WHERE b.id = 3) COLUMNS (vertices(p) AS v));
----
0,3

# id: path/6  an unbounded walk with no selector is refused (the standard requires a selector or a restrictive mode)
statement error has no upper bound
SELECT * FROM GRAPH_TABLE (pg MATCH p = (a:Person WHERE a.id = 0)-[k:knows]->+(b:Person) COLUMNS (b.id));

# id: path/7  a selector over a path of several edges (#414)
statement ok
SELECT * FROM GRAPH_TABLE (pg MATCH p = ANY SHORTEST (a:Person)-[k:knows]->*(b:Person)-[s:studyAt]->(c:School) COLUMNS (a.id));

# id: path/8  a quantified edge variable stands for several edges: its property is not one value
statement error stands for several edges
SELECT * FROM GRAPH_TABLE (pg MATCH (a:Person WHERE a.id = 0)-[k:knows]->{1,2}(b:Person) COLUMNS (k.createDate));

# id: keep/1  KEEP on one path is the prefix form
query II rowsort
SELECT * FROM GRAPH_TABLE (pg MATCH p = (a:Person WHERE a.id = 0)-[k:knows]->*(b:Person) KEEP ANY SHORTEST COLUMNS (b.id AS b, path_length(p) AS len));
----
0 0
1 1
2 1
3 1

# id: keep/2
query T
SELECT array_to_string(v, ',') FROM GRAPH_TABLE (pg MATCH p = (a:Person WHERE a.id = 0)-[k:knows]->+(b:Person WHERE b.id = 3) KEEP SHORTEST 2 PATHS COLUMNS (vertices(p) AS v));
----
0,3
0,1,3

# id: keep/3  KEEP after WHERE is read, not ignored (#409): the walk 0->3->0->3 repeats an edge
query I
SELECT count(*) FROM GRAPH_TABLE (pg MATCH (a:Person)-[k:knows]->{1,3}(b:Person) WHERE a.id = 0 KEEP TRAIL COLUMNS (b.id));
----
12

# id: keep/4  KEEP over a pattern of two paths
statement ok
SELECT * FROM GRAPH_TABLE (pg MATCH (a:Person WHERE a.id = 0)-[k:knows]->*(b:Person), (b)-[s:studyAt]->(c:School) KEEP ANY SHORTEST COLUMNS (b.id, c.school_name));

# id: rows/1  ONE ROW PER MATCH is the default
query I rowsort
SELECT * FROM GRAPH_TABLE (pg MATCH (a:Person)-[k:knows]->(b:Person) WHERE a.id = 0 ONE ROW PER MATCH COLUMNS (b.id));
----
1
2
3

# id: rows/2  ONE ROW PER STEP (#414)
statement ok
SELECT * FROM GRAPH_TABLE (pg MATCH p = (a:Person WHERE a.id = 0)-[k:knows]->{1,2}(b:Person) ONE ROW PER STEP (v1, e, v2) COLUMNS (v1.id));

# id: errors/1  an aggregate in COLUMNS needs a group variable
statement error aggregates in COLUMNS need a quantified edge variable
SELECT * FROM GRAPH_TABLE (pg MATCH (a:Person)-[k:knows]->(b:Person) COLUMNS (count(*) AS n));

# id: errors/1b  an aggregate beside a property
statement error aggregates in COLUMNS need a quantified edge variable
SELECT * FROM GRAPH_TABLE (pg MATCH (a:Person)-[k:knows]->(b:Person) COLUMNS (a.id, sum(k.createDate)));

# id: errors/2  a subquery inside the pattern, on a table the statement does not name (#414)
query I rowsort
SELECT * FROM GRAPH_TABLE (pg MATCH (a:Person)-[k:knows]->(b:Person) WHERE a.id = (SELECT min(id) FROM Student) COLUMNS (b.id));
----
1
2
3

# id: errors/3  LATERAL (#414)
statement ok
SELECT * FROM Student s, LATERAL GRAPH_TABLE (pg MATCH (a:Person)-[k:knows]->(b:Person) WHERE a.id = s.id COLUMNS (b.id));

# id: errors/4  a pattern that reads a table outside it (#414)
statement ok
SELECT * FROM Student s, GRAPH_TABLE (pg MATCH (a:Person)-[k:knows]->(b:Person) WHERE a.id = s.id COLUMNS (b.id));

# id: errors/5  a Cypher property map is not SQL/PGQ
statement error property maps .* are Cypher
SELECT * FROM GRAPH_TABLE (pg MATCH (a:Person {name: 'Daniel'}) COLUMNS (a.id));

# id: errors/6  a Cypher range is not SQL/PGQ
statement error Cypher's range; .* write -\[k:knows\]->\{1,3\}
SELECT * FROM GRAPH_TABLE (pg MATCH (a:Person)-[k:knows*1..3]->(b:Person) COLUMNS (a.id));

# id: errors/7  a path variable is not a value: COLUMNS takes its functions (#388)
statement error 'p' is a path variable, and a path cannot be a column; use path_length\(p\), vertices\(p\), edges\(p\) or element_id\(p\)
SELECT * FROM GRAPH_TABLE (pg MATCH p = (a:Person)-[k:knows]->(b:Person) COLUMNS (p AS p));

# id: errors/8  nor is a node variable: COLUMNS takes its properties
statement error 'a' is a node variable, and a node cannot be a column
SELECT * FROM GRAPH_TABLE (pg MATCH (a:Person)-[k:knows]->(b:Person) COLUMNS (a));
