# Forms that are not SQL/PGQ, refused with the standard form to write (#300).
# The standard refuses each; Ursa's error names the fix.

statement ok
CREATE TABLE Student AS SELECT * FROM (VALUES (0,'Daniel'),(1,'Tavneet'),(2,'Gabor'),(3,'Peter'),(4,'David')) t(id, name);

statement ok
CREATE TABLE know AS SELECT * FROM (VALUES (0,1,10),(0,2,11),(0,3,12),(3,0,13),(1,2,14),(1,3,15),(2,3,16),(4,3,17)) t(src, dst, createDate);

statement ok
CREATE PROPERTY GRAPH pg VERTEX TABLES (Student) EDGE TABLES (know SOURCE KEY (src) REFERENCES Student (id) DESTINATION KEY (dst) REFERENCES Student (id));

# id: hints/1  Cypher's MATCH … RETURN as a statement
statement error a statement cannot start with MATCH: .* SELECT \* FROM GRAPH_TABLE \(g MATCH
MATCH (a)-[k]->(b) RETURN a.id, b.id;

# id: hints/2  OPTIONAL MATCH
statement error a statement cannot start with MATCH
OPTIONAL MATCH (a)-[k]->(b) RETURN a.id;

# id: hints/3  a graph read as a table
statement error 'pg' is a graph, not a table: read its nodes or edges with FROM pg.nodes or FROM pg.edges
SELECT * FROM pg;

# id: hints/4  a graph function named as a column of the node table
statement error pagerank is a graph function, not a column: join its rows on id
SELECT id, pagerank FROM pg.nodes;

# id: hints/5  a graph function called as a scalar
statement error pagerank is a table function, not a scalar one
SELECT pagerank(pg);
