"""Type stub for the maturin-built native extension ``ursa._ursa``.

The compiled module has no Python source for the type checker to read, so this
stub declares its surface. Keep it in sync with ``ursa-py/src/lib.rs``.
"""

from typing import Any

# The exception hierarchy (defined in Rust; ColumnNotFoundError is also a
# ValueError). Every engine
# error reaches Python as one of these — ordinary exceptions, so `except Exception`
# catches them (a Rust panic would escape as a BaseException instead).
class UrsaError(Exception): ...
class ColumnNotFoundError(UrsaError, ValueError): ...
class ComputeError(UrsaError): ...

def __core_version() -> str: ...

# The CSR topology + IdMap, built once and cached on the EdgeFrame. Opaque handle;
# built by build_index and passed to every graph op over the frame.
class GraphIndex:
    def has_weights(self, weight_json: str) -> bool: ...
    def _weight_eval_count(self) -> int: ...
    def _mask_build_count(self) -> int: ...

# A scan_nodes frame's scanned table, kept in the frame's cell: one superset of
# the columns read so far. Opaque handle; the plan reads through it.
class NodeTableCache:
    def __init__(self) -> None: ...
    def _scan_count(self) -> int: ...
    def _held(self) -> list[str] | None: ...

# Build the graph index from an edge batch list — a list of pyarrow RecordBatches
# whose first two columns are the (canonicalized) src/dst id columns (int64 or
# string; the one CSR build site). The batches are interned as a stream, so a large
# edge table never has to be concatenated into one contiguous batch first.
def build_index(edges: Any) -> GraphIndex: ...

# Total topology builds so far (test/observability hook for the index contract).
def _topology_build_count() -> int: ...

# Turn the scan log on (clearing it) or off; returns (kind, columns, filters
# pushed) per native scan since it was last turned on (test/observability hook).
def _scan_log(record: bool) -> list[tuple[str, list[str], int]]: ...

# The plan object a frame holds (ursa_plan::lazy::Node): each method builds the
# next step in Rust, validates it there, and returns the new node. Step
# arguments arrive as plan IR (Python values); `error` is the exception Python
# met converting them, raised where a collect would have raised it.
class PlanNode:
    @staticmethod
    def edge_table(table: Any, endpoints: tuple[Any, Any], src: str, dst: str) -> PlanNode: ...
    @staticmethod
    def node_table(table: Any, id: str) -> PlanNode: ...
    @staticmethod
    def scan_edges(
        path: Any,
        src: str,
        dst: str,
        on_null: str,
        spec: dict[str, Any],
        csv: dict[str, Any] | None = ...,
    ) -> PlanNode: ...
    @staticmethod
    def scan_nodes(
        path: Any, id: str, spec: dict[str, Any], csv: dict[str, Any] | None = ...
    ) -> PlanNode: ...
    def filter(self, predicate: Any, error: BaseException | None = ...) -> PlanNode: ...
    def select(self, items: Any, error: BaseException | None = ...) -> PlanNode: ...
    def with_columns(self, columns: list[tuple[str, Any, PlanNode | None]]) -> PlanNode: ...
    def rename(self, mapping: Any, error: BaseException | None = ...) -> PlanNode: ...
    def sort(self, by: Any, error: BaseException | None = ...) -> PlanNode: ...
    def head(self, n: Any, error: BaseException | None = ...) -> PlanNode: ...
    def sample(
        self, n: Any, seed: Any, draw: tuple[Any, Any], error: BaseException | None = ...
    ) -> PlanNode: ...
    def distinct(self) -> PlanNode: ...
    def join(
        self, right: PlanNode, on: Any, how: Any, error: BaseException | None = ...
    ) -> PlanNode: ...
    def group_by_agg(self, keys: Any, aggs: Any, error: BaseException | None = ...) -> PlanNode: ...
    def nodes(self) -> PlanNode: ...
    def reverse(self) -> PlanNode: ...
    @staticmethod
    def hop(edges: PlanNode, n: Any, direction: Any, seeds: Any) -> PlanNode: ...
    @staticmethod
    def shortest_path(
        edges: PlanNode, source: Any, target: Any, weight: Any, direction: Any
    ) -> PlanNode: ...
    @staticmethod
    def random_walk(
        edges: PlanNode, start: Any, steps: Any, walks_per_node: Any, seed: Any
    ) -> PlanNode: ...
    @staticmethod
    def describe(edges: PlanNode, full: bool, direction: Any) -> PlanNode: ...
    # Run the plan -> list[pyarrow.RecordBatch], or the pyarrow.Table a plain
    # in-memory frame already is.
    def collect(self) -> Any: ...
    # The schema collect() returns (a pyarrow.Schema), from a dry run.
    def schema(self) -> Any: ...
    def explain(self, physical: bool = ...) -> str: ...
    # The checked graph index of an edge frame, for the eager whole-graph stats.
    def graph_index(self) -> GraphIndex: ...
    def ops(self) -> list[str]: ...
    @property
    def n_steps(self) -> int: ...
    @property
    def src_col(self) -> str: ...
    @property
    def dst_col(self) -> str: ...
    @property
    def id_col(self) -> str: ...
    @property
    def index_cell(self) -> IndexCell: ...
    @property
    def node_cache(self) -> NodeTableCache | None: ...
    @property
    def cached_seeds(self) -> Any: ...
    # (table, endpoints, scan spec) of the frame's source.
    @property
    def source(self) -> tuple[Any, Any, Any]: ...

# A frame's index cell, shared by the derivations that keep its rows.
class IndexCell:
    value: GraphIndex | None
    @property
    def lock(self) -> Any: ...

# The engine's lists, raised as the frame layer's errors.
def check_agg_fn(func: str) -> None: ...
def check_direction(verb: str, direction: Any) -> None: ...
def check_on_null(on_null: Any) -> None: ...
def check_scan_path(path: str, verb: str) -> bool: ...

# The whole-graph stats take direction "out" (default), "in" or "both". "both"
# reads the graph as undirected: one edge per distinct unordered pair, self-loops
# dropped (NetworkX's G.to_undirected()). "in" equals "out" over the whole graph.

# Whole-graph edge density (eager scalar); "both" is the undirected density.
def graph_density(index: GraphIndex, direction: str = ...) -> float: ...

# Average shortest-path length over reachable pairs (eager scalar).
def graph_avg_path_length(
    index: GraphIndex, sample: float | None = ..., direction: str = ...
) -> float: ...

# Graph diameter (eager scalar); approximate is a lower-bound estimate.
def graph_diameter(index: GraphIndex, approximate: bool, direction: str = ...) -> int: ...

